# ========================================================
# uai to na foto — Docker Compose Environment Variables
# ========================================================

# General & Network
PORT=80
NODE_ENV=production
ENV=production
FRONTEND_URL=https://uaitonafoto.com.br
CORS_ORIGIN=https://uaitonafoto.com.br
CORS_ALLOWED_ORIGINS=https://uaitonafoto.com.br
JWT_SECRET=super-secret-key-change-in-production

# Firebase Admin (API)
FIREBASE_PROJECT_ID=uaitonafoto
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=uaitonafoto.firebasestorage.app

# Nodemailer / Email Service (API)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="uai to na foto <no-reply@uaitonafoto.com.br>"

# Cloudflare R2 Storage (API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=uaitonafoto
R2_PUBLIC_URL=https://cdn.uaitonafoto.com.br

# AbacatePay Billing Gateway (API)
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=

# Frontend / UI (Build Arguments)
VITE_BASE_URL=https://api.uaitonafoto.com.br

# Firebase Client (UI)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=uaitonafoto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=uaitonafoto
VITE_FIREBASE_STORAGE_BUCKET=uaitonafoto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
