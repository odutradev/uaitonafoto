# ========================================================
# Dokploy / Docker Compose Environment Variables
# ========================================================

# General & Network
PORT=80
NODE_ENV=production
ENV=production
CORS_ORIGIN=https://meudominio.com.br
CORS_ALLOWED_ORIGINS=https://meudominio.com.br
JWT_SECRET=super-secret-key-change-in-production

# Firebase Admin (API)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=

# Nodemailer / Email Service (API)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="No Reply <no-reply@meudominio.com.br>"

# Lottery API Provider & Proxy (API)
LOTTERY_API_PROVIDER=loteriascaixa
LOTTERY_DISABLE_PROXY=true
# CAIXA_PROXY=http://10.0.1.32:3128
# HTTPS_PROXY=http://10.0.1.32:3128

# Frontend / UI (Build Arguments)
VITE_BASE_URL=https://api.meudominio.com.br

# Firebase Client (UI)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
