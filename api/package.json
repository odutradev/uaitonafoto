{
  "name": "uaitonafoto-api",
  "version": "1.0.1",
  "description": "API do uai to na foto",
  "license": "ISC",
  "author": "https://github.com/odutradev",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "check": "tsc --noEmit",
    "seed": "tsx --conditions=import src/payment/seed/index.ts",
    "webhook:secret": "tsx src/payment/scripts/generateWebhookSecret.ts",
    "start": "node --disable-warning=DEP0040 dist/server.js",
    "publish": "npx pub --bump-package --build --push"
  },
  "dependencies": {
    "@abacatepay/sdk": "^3.0.0",
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "archiver": "^8.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^13.9.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.1.1",
    "mongoose": "^9.11.4",
    "multer": "^2.1.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "tsup": "^8.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}
