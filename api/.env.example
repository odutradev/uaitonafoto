NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:1000
CORS_ORIGIN=http://localhost:1000,https://uaitonafoto.com.br,https://www.uaitonafoto.com.br
JWT_SECRET=dev-secret-key-change-in-production
SWAGGER_ENABLED=true
ENABLE_ROUTINES=true
CHECKOUT_EXPIRATION_HOURS=24

# Database (MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGODB_DB_NAME=uaitonafoto

# Firebase Admin
FIREBASE_PROJECT_ID=uaitonafoto
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=uaitonafoto.firebasestorage.app

# Email Service
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_USER=contato@uaitonafoto.com.br
EMAIL_PASS=
EMAIL_FROM="uaiToNaFoto <contato@uaitonafoto.com.br>"

# AbacatePay Billing Gateway
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_PIX_ONLY=false
