{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@actions": ["./src/actions"],
      "@actions/*": ["./src/actions/*"],
      "@config": ["./src/config"],
      "@config/*": ["./src/config/*"],
      "@docs": ["./src/docs"],
      "@docs/*": ["./src/docs/*"],
      "@email": ["./src/email"],
      "@email/*": ["./src/email/*"],
      "@error": ["./src/error"],
      "@error/*": ["./src/error/*"],
      "@factories": ["./src/factories"],
      "@factories/*": ["./src/factories/*"],
      "@firebase": ["./src/firebase"],
      "@firebase/*": ["./src/firebase/*"],
      "@firebaseAuth": ["./src/firebase/firebaseAuth"],
      "@firebaseAuth/*": ["./src/firebase/firebaseAuth/*"],
      "@firestore": ["./src/firebase/firestore"],
      "@firestore/*": ["./src/firebase/firestore/*"],
      "@middlewares": ["./src/middlewares"],
      "@middlewares/*": ["./src/middlewares/*"],
      "@repositories": ["./src/repositories"],
      "@repositories/*": ["./src/repositories/*"],
      "@routes": ["./src/routes"],
      "@routes/*": ["./src/routes/*"],
      "@services": ["./src/services"],
      "@services/*": ["./src/services/*"],
      "@appTypes": ["./src/types"],
      "@appTypes/*": ["./src/types/*"],
      "@utils": ["./src/utils"],
      "@utils/*": ["./src/utils/*"]
    }
  },
  "include": [
    "src/**/*"
  ]
}
